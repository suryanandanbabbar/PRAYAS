{
  "name": "@suryanandanbabbar/prayas-kit",
  "version": "1.0.0",
  "description": "A TypeScript toolkit for flood simulation, geospatial utilities, weather integration, and audio processing.",
  "type": "module",
  "author": "Suryanandan Babbar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suryanandanbabbar/PRAYAS.git"
  },
  "homepage": "https://github.com/suryanandanbabbar/PRAYAS#readme",
  "bugs": {
    "url": "https://github.com/suryanandanbabbar/PRAYAS/issues"
  },
  "keywords": [
    "prayas",
    "flood",
    "flood-simulation",
    "gis",
    "geospatial",
    "weather",
    "disaster-management",
    "typescript",
    "sdk",
    "utility"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src tests",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.12.7",
    "eslint": "^9.0.0",
    "prettier": "^3.2.5",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "esbuild": "0.27.2"
  }
}
